---
import PhoneMockup from './PhoneMockup.astro';
---

<!-- overflow-x-clip (not overflow-hidden) so the glow can't cause sideways
     scroll, while the phone's downward drop shadow is free to bleed past the
     section instead of being chopped off at a hard line. -->
<section class="relative overflow-x-clip px-6 pt-8 pb-12 md:px-10 md:pt-24 md:pb-28 lg:px-14 lg:pt-12 lg:pb-16">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
    <!-- Text content -->
    <div class="text-center lg:text-left">
      <h1 class="font-display mb-6 text-balance font-semibold leading-[0.95]" style="font-size: var(--text-hero);">
        Your <span class="text-accent">countermove</span><br />for any message.
      </h1>

      <p class="mx-auto mb-10 max-w-xl text-lg leading-relaxed text-text-secondary md:text-xl lg:mx-0">
        Reply or reach out, in any app, in your tone. Describe it, paste it, snap it, or say it. Four ready-to-send options in seconds.
      </p>

      <div class="flex flex-col items-center gap-4 lg:items-start">
        <div class="flex items-center gap-3 sm:gap-4">
          <a href="https://apps.apple.com/app/id6761346279" target="_blank" rel="noopener" class="inline-block transition-transform duration-200 hover:scale-105">
            <img src="/app-store-badge.svg" alt="Download on the App Store" width="160" height="54" />
          </a>
        </div>
        <p class="text-sm text-text-tertiary">
          Free to download. No account needed.
        </p>
      </div>
    </div>

    <!-- Phone preview -->
    <div class="flex justify-center lg:justify-end">
      <PhoneMockup
        screenshot="/screenshots/home.png"
        alt="parry home screen with 'we need to talk' typed into the input and the Witty tone selected"
        size="hero"
      />
    </div>
  </div>
</section>
