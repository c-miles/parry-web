---
import Icon from './Icon.astro';
import PhoneMockup from './PhoneMockup.astro';

// Two cards. Card 1 sells custom tones with an inline UI composition (no
// bezel) so the form fields are readable at web scale. Card 2 sells the
// thread-reading outcome of multimodal input, with the attach screenshot
// because the mic/camera/attach affordances genuinely need device chrome
// to read.
---

<section class="px-6 py-24 md:px-10 md:py-32 lg:px-14">
  <div class="mx-auto max-w-7xl">
    <div class="mb-20 max-w-2xl animate-on-scroll">
      <p class="eyebrow mb-5">Why parry</p>
      <h2 class="font-display text-balance font-semibold leading-[1.05]" style="font-size: var(--text-display);">
        Built for the way you actually message.
      </h2>
    </div>

    <div class="flex flex-col gap-24 md:gap-32">
      <!-- Card 1: custom tones with inline UI composition -->
      <div class="grid items-center gap-10 md:gap-16 lg:grid-cols-2 animate-on-scroll">
        <div>
          <div class="mb-6 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-accent-soft">
            <Icon name="palette" size={22} class="text-accent-text" />
          </div>
          <h3 class="font-display mb-4 text-3xl font-semibold leading-tight tracking-tight md:text-4xl">
            Make a tone that's you.
          </h3>
          <p class="max-w-md text-lg leading-relaxed text-text-secondary">
            Casual covers the basics. When you want a voice that's actually yours, build a custom tone in a sentence and parry will speak that way in every reply. Free includes one custom tone. Pro unlocks four.
          </p>
        </div>

        <!-- Cropped portrait of the Create Tone screen — visual sibling to
             Step 01's .input-panel (same soft-frame treatment for screenshot
             fragments). background-position: top so the Save Tone CTA stays
             visible. -->
        <div class="create-tone-panel mx-auto w-full max-w-md" aria-label="parry Create Tone screen with the name 'Deadpan' and description 'dry humor, deliver wit with a straight face, never break for emphasis' typed in, Save Tone button highlighted in coral"></div>
      </div>

      <!-- Card 2: thread-reading outcome, attach screenshot (phone-led, visual on the left) -->

      <div class="grid items-center gap-10 md:gap-16 lg:grid-cols-2 animate-on-scroll lg:[&>*:first-child]:order-2">
        <div>
          <div class="mb-6 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-accent-soft">
            <Icon name="magnifying-glass" size={22} class="text-accent-text" />
          </div>
          <h3 class="font-display mb-4 text-3xl font-semibold leading-tight tracking-tight md:text-4xl">
            It reads the room for you.
          </h3>
          <p class="max-w-md text-lg leading-relaxed text-text-secondary">
            parry picks up on what's actually going on. It reads the relationship and the stakes before suggesting how to respond. Drop in a screenshot, speak the situation, or type it out.
          </p>
        </div>
        <PhoneMockup
          screenshot="/screenshots/voice.png"
          alt="parry home screen during voice dictation, coral waveform mid-pulse in the input bar with the Professional tone chip selected"
          size="step"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Cropped portrait of create-tone.png for Features Card 1. Same border /
     radius / shadow recipe as Step 01's .input-panel — visual sibling
     treatment for screenshot fragments in soft frames rather than bezels. */
  .create-tone-panel {
    aspect-ratio: 9 / 10;
    background-image: url('/screenshots/create-tone.png');
    background-position: center top;
    background-size: cover;
    background-repeat: no-repeat;
    border-radius: 28px;
    border: 1px solid var(--color-hairline);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.03),
      0 30px 60px rgba(0, 0, 0, 0.45);
  }
</style>
