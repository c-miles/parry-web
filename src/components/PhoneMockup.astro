---
interface Props {
  screenshot: string;
  alt: string;
  size?: 'hero' | 'step-large' | 'step';
}

const { screenshot, alt, size = 'hero' } = Astro.props;
---

<div class={`phone-frame phone-frame--${size}`}>
  <div class="phone-aspect">
    <div class="phone-bezel">
      <div class="phone-screen">
        <img src={screenshot} alt={alt} loading={size === 'hero' ? 'eager' : 'lazy'} decoding="async" />
      </div>
    </div>
  </div>
</div>

<style>
  /* Bezel mirrors the design system used for parry's App Store screenshots:
     titanium gradient chassis, subtle coral wash that matches the page's
     ambient hero glow, iPhone-accurate chassis-to-screen corner radius
     ratio. Three size variants reuse the same proportions. */

  .phone-frame {
    display: flex;
    justify-content: center;
  }

  .phone-aspect {
    aspect-ratio: 9 / 19.5;
    position: relative;
  }

  /* Mobile / single-column sizing is driven by WIDTH, not height. The phone is
     tall and narrow, so its rendered width is what decides how readable the
     screenshot's text is — sizing by width lets us dial that in directly. It
     also fixes a scroll glitch: a viewport-HEIGHT unit (dvh) recomputes as the
     mobile browser's address bar shows and hides, so a height-driven phone
     visibly grows and shrinks while you scroll. vw doesn't change on scroll, so
     the phone stays put. Height follows from aspect-ratio. The three variants
     stay close in size (hero marginally largest) since on a phone they're
     viewed one at a time, not side by side. */
  .phone-frame--hero .phone-aspect {
    width: clamp(240px, 74vw, 330px);
    --bezel-pad: 5px;
    --chassis-radius: 44px;
    --screen-radius: 39px;
  }

  .phone-frame--step-large .phone-aspect {
    width: clamp(240px, 74vw, 320px);
    --bezel-pad: 4.5px;
    --chassis-radius: 38px;
    --screen-radius: 34px;
  }

  .phone-frame--step .phone-aspect {
    width: clamp(235px, 71vw, 310px);
    --bezel-pad: 4px;
    --chassis-radius: 34px;
    --screen-radius: 30px;
  }

  /* From lg up the page is a two-column grid where each phone sits beside a
     column of body text, so size by height there and let width follow from
     aspect-ratio. Desktop browsers have no collapsing chrome, so a
     viewport-height unit is stable here — the scroll-resize problem the
     width-based rules above avoid only happens on mobile. */
  @media (min-width: 1024px) {
    .phone-frame--hero .phone-aspect {
      width: auto;
      height: clamp(480px, 68dvh, 720px);
    }
    .phone-frame--step-large .phone-aspect {
      width: auto;
      height: clamp(460px, 54vw, 660px);
    }
    .phone-frame--step .phone-aspect {
      width: auto;
      height: clamp(420px, 48vw, 600px);
    }
  }

  .phone-bezel {
    position: relative;
    height: 100%;
    width: 100%;
    padding: var(--bezel-pad);
    border-radius: var(--chassis-radius);
    background: linear-gradient(155deg, #3a3340 0%, #1c1822 100%);
    /* Drop shadow grounds the device; the inset highlights define the chassis.
       The coral wash matches the page's --color-accent-soft (0.12 alpha) used
       by .hero-glow, so the phone reads as ambient warmth, not a coral ring. */
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.10),
      inset 0 2px 4px rgba(255, 255, 255, 0.06),
      inset 0 -2px 6px rgba(0, 0, 0, 0.55),
      0 0 80px 12px rgba(232, 115, 74, 0.06),
      0 40px 80px rgba(0, 0, 0, 0.55);
  }

  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--screen-radius);
    overflow: hidden;
    background: #0a070d;
  }

  .phone-screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
</style>
